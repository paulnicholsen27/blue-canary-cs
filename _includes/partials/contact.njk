<!-- ============================================ -->
<!--                Contact Form #490                 -->
<!-- ============================================ -->

<section id="contact">
    <div class="cs-container">
        <!-- Contact Info -->
        <div class="cs-content">
            <span class="cs-topper">Contact Us</span>
            <h2 class="cs-title">Contact Information</h2>
            <p class="cs-text">
                Not sure where to start? That's okay. Send us a message and we'll walk through your needs, answer your questions, and help you decide on the right next step.
            </p>
            
            <!--Email-->
            <span class="cs-header">Email</span>
            <a href="mailto:info@bluecanarywebdesign.com" class="cs-link">info@bluecanarywebdesign.com</a>
            <!--Phone-->
            <span class="cs-header">Phone</span>
            <a href="tel:929-277-8037" class="cs-link">(929) 277-8037</a>

            <!--Social Buttons-->
            <div class="cs-social">
                <a class="cs-social-link" aria-label="visit linkedin profile" href="https://www.linkedin.com/company/blue-canary-web-design/">
                    <img class="cs-social-img" aria-hidden="true" loading="lazy" decoding="async" src="/assets/images/linkedin.png" alt="linkedin" width="11" height="11">
                </a>
                <a class="cs-social-link" aria-label="visit google profile" href="https://share.google/g54jvOCG7xpoUDWWv">
                    <img class="cs-social-img" aria-hidden="true" loading="lazy" decoding="async" src="https://csimg.nyc3.digitaloceanspaces.com/Social/google.svg" alt="google" width="11" height="11">
                </a>
            </div>
        </div>
        <!-- Form -->
        <form id="cs-form-490" name="Contact Form" method="post" action="/" data-netlify="true" netlify-honeypot="bot-field">
            <input type="hidden" name="form-name" value="Contact Form">
            <p hidden>
                <label>
                    Don't fill this out if you're human:
                    <input name="bot-field" autocomplete="off" />
                </label>
            </p>
            <label class="cs-label">
                Name
                <input class="cs-input" required type="text" id="name-490" name="name" autocomplete="name" placeholder="John/Jane Doe">
            </label>
            <label class="cs-label">
                Email
                <input class="cs-input" required type="email" id="email-490" name="email" autocomplete="email" placeholder="name@company.com">
            </label>
            <label class="cs-label">
                Phone
                <input class="cs-input" required type="tel" id="phone-490" name="phone" autocomplete="tel" placeholder="+1 (206) 987-6543">
            </label>
            <label class="cs-label">
                How Did You Find Us
                <input class="cs-input" type="text" id="find-490" name="find-us" placeholder="Social Media, Family, Friend...">
            </label>
            <label class="cs-label-message">
                Message
                <textarea class="cs-input" required name="message" id="message-490" placeholder="Hello, I'm interested in..."></textarea>
            </label>
            <p class="cs-form-success" id="cs-form-490-success" role="status" aria-live="polite" hidden></p>
            <p class="cs-form-error" id="cs-form-490-error" role="status" aria-live="polite" hidden></p>
            <button class="cs-button-solid" type="submit">Submit Message Now</button>
        </form>
    </div>
</section>
<!-- ============================================ -->
<!--              End Contact Form                -->
<!-- ============================================ -->
