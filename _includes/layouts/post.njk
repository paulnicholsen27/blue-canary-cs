---
layout: layouts/base.njk
---

<article id="blog-post">
  <nav class="cs-blog-breadcrumb" aria-label="Breadcrumb">
    <a class="cs-blog-breadcrumb-link" href="/blog/">Back to Blog</a>
  </nav>

  <header class="cs-blog-header">
    <h1 class="cs-title">{{ title }}</h1>
    {% if date %}
      <p class="cs-blog-meta"><time datetime="{{ date | dateToRfc3339 }}">{{ date | readableDate }}</time></p>
    {% endif %}
  </header>

  <div class="cs-blog-prose">
    {% if shareImage %}
      <p><img class="cs-blog-featured-img" src="{{ shareImage }}" alt="{{ title | escape }}" loading="lazy" decoding="async"></p>
    {% endif %}
    {{ content | safe }}
  </div>

  <div class="cs-blog-cta-wrapper">
    <a class="cs-blog-cta" href="https://calendly.com/bluecanarywebdesign/initialconsult" target="_blank" rel="noopener">Schedule a Free Consultation</a>
  </div>
  
  <footer class="cs-blog-post-footer">
    <a class="cs-blog-back" href="/blog/">Back to all posts</a>
  </footer>
</article>

<!-- Article Schema for SEO -->
<script type="application/ld+json">
{
    "@context": "https://schema.org",
    "@type": "Article",
    "headline": "{{ title | escape }}",
    "description": "{{ description | escape }}",
    "datePublished": "{{ date | dateToRfc3339 }}",
    "dateModified": "{{ date | dateToRfc3339 }}",
    {% if shareImage %}"image": "{{ site.url }}{{ shareImage }}",{% endif %}
    "author": {
        "@type": "Organization",
        "name": "Blue Canary Web Design",
        "url": "https://www.bluecanarywebdesign.com"
    },
    "publisher": {
        "@type": "Organization",
        "name": "Blue Canary Web Design",
        "url": "https://www.bluecanarywebdesign.com",
        "logo": {
            "@type": "ImageObject",
            "url": "https://www.bluecanarywebdesign.com/assets/logos/vert_rt_fulllogo.png"
        }
    },
    "mainEntityOfPage": {
        "@type": "WebPage",
        "@id": "{{ site.url }}{{ page.url }}"
    }
}
</script>
