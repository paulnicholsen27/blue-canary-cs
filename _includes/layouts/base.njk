<!DOCTYPE html>
<html lang="en">
  <head>
    {% set ogTypeValue = ogType or 'website' %}

    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=AW-18472624902"></script>
    <script>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());

      gtag('config', 'AW-18472624902');
    </script>
    {% if shareImageValue %}
      {% set shareImageUrl = site.url + shareImageValue %}
    {% endif %}

    <title>{{ title }}{% if title %} | {% endif %}{{ site.name }}</title>
    <meta charset="utf-8" />
    {% if description %}<meta name="description" content="{{ description | escape }}" />{% endif %}

    <meta property="og:type" content="{{ ogTypeValue }}" />
    <meta property="og:site_name" content="{{ site.name | escape }}" />
    <meta property="og:title" content="{{ title | escape }}" />
    {% if description %}<meta property="og:description" content="{{ description | escape }}" />{% endif %}
    <meta property="og:url" content="{{ site.url }}{{ page.url }}" />

    {% if shareImageUrl %}
      <meta property="og:image" content="{{ shareImageUrl }}" />
      <meta name="twitter:card" content="summary_large_image" />
      <meta name="twitter:image" content="{{ shareImageUrl }}" />
    {% else %}
      <meta name="twitter:card" content="summary" />
    {% endif %}
    <meta name="twitter:title" content="{{ title | escape }}" />
    {% if description %}<meta name="twitter:description" content="{{ description | escape }}" />{% endif %}

    <!-- BreadcrumbList Schema for SEO -->
    {% if page.url != "/" %}
    <script type="application/ld+json">
    {
        "@context": "https://schema.org",
        "@type": "BreadcrumbList",
        "itemListElement": [
            {
                "@type": "ListItem",
                "position": 1,
                "name": "Home",
                "item": "{{ site.url }}/"
            }
            {% if page.url.startsWith('/blog/') and page.url != '/blog/' %},
            {
                "@type": "ListItem",
                "position": 2,
                "name": "Blog",
                "item": "{{ site.url }}/blog/"
            },
            {
                "@type": "ListItem",
                "position": 3,
                "name": "{{ title | escape }}",
                "item": "{{ site.url }}{{ page.url }}"
            }
            {% else %},
            {
                "@type": "ListItem",
                "position": 2,
                "name": "{{ title | escape }}",
                "item": "{{ site.url }}{{ page.url }}"
            }
            {% endif %}
        ]
    }
    </script>
    {% endif %}
    


  </head>
  {% set pageSlug = page.url | replace("/", "") | replace("/", "-") or "home" %}
  <body class="page-{{ pageSlug }}{% if bodyClass %} {{ bodyClass }}{% endif %}">
    {% include "partials/nav.njk" %}


    <main id="main"{% if mainClass %} class="{{ mainClass }}"{% endif %}>
    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=AW-18472624902"></script>
    <script>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());

      gtag('config', 'AW-18472624902');
    </script>
      <section class="cs-page-section">
        <div class="cs-container">
          {{ content | safe }}
        </div>
      </section>
    </main>

    {% include "partials/contact.njk" %}
    {% include "partials/footer.njk" %}
  </body>
</html>
