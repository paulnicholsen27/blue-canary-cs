---
layout: layouts/base.njk
title: Web Design Blog | Tips & Insights
description: Practical web design tips, SEO advice, and insights for small businesses looking to improve their online presence.
permalink: blog/index.html
---

<!-- ============================================ -->
<!--                 Blog Hero                    -->
<!-- ============================================ -->

<section id="blog-hero">
    <div class="cs-container">
        <div class="cs-content">
            <span class="cs-topper">Blog</span>
            <h1 class="cs-title">Web Design Tips & Insights</h1>
            <p class="cs-text">
                Practical advice on web design, SEO, and building a website that actually works for your small business.
            </p>
        </div>
    </div>
</section>

<!-- ============================================ -->
<!--                 Blog Posts                   -->
<!-- ============================================ -->

<section id="blog-posts">
    <div class="cs-container">
        <ul class="cs-post-list">
            {%- for post in collections.post | reverse -%}
            <li class="cs-post-card">
                <div class="cs-post-content">
                    {% if post.data.date %}
                    <time class="cs-post-date" datetime="{{ post.data.date | dateToRfc3339 }}">{{ post.data.date | readableDate }}</time>
                    {% endif %}
                    <h2 class="cs-post-title">
                        <a href="{{ post.url }}">{{ post.data.title }}</a>
                    </h2>
                    {% if post.data.description %}
                    <p class="cs-post-excerpt">{{ post.data.description }}</p>
                    {% endif %}
                    <a class="cs-post-link" href="{{ post.url }}">
                        Read Article
                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 4l-1.41 1.41L16.17 11H4v2h12.17l-5.58 5.59L12 20l8-8z"/></svg>
                    </a>
                </div>
            </li>
            {%- endfor -%}
        </ul>
    </div>
</section>

<!-- ============================================ -->
<!--                 Blog CTA                     -->
<!-- ============================================ -->

<section id="blog-cta">
    <div class="cs-container">
        <div class="cs-content">
            <h2 class="cs-title">Ready to Get Started?</h2>
            <p class="cs-text">Let's talk about your website and how we can help your business grow.</p>
            <a href="https://calendly.com/bluecanarywebdesign/initialconsult" class="cs-button-solid" target="_blank" rel="noopener">Schedule a Free Consultation</a>
        </div>
    </div>
</section>
