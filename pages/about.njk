---
layout: layouts/base.njk
title: About Blue Canary Web Design
description: Meet Blue Canary Web Design, a small studio building clear, honest websites for small businesses and mission-driven organizations.
permalink: about/index.html
---

<!-- ============================================ -->
<!--                About Hero                    -->
<!-- ============================================ -->

<section id="about-hero">
    <div class="cs-container">
        <div class="cs-content">
            <span class="cs-topper">{{ about.hero.eyebrow }}</span>
            <h1 class="cs-title">{{ about.hero.title }}</h1>
            <p class="cs-text">
                {{ about.hero.body }}
            </p>
        </div>
    </div>
</section>

<!-- ============================================ -->
<!--                About Story                   -->
<!-- ============================================ -->

<section id="about-story">
    <div class="cs-container">
        <div class="cs-content">
            <h2 class="cs-title">{{ about.story.title }}</h2>
            {% for paragraph in about.story.paragraphs %}
            <p class="cs-text">{{ paragraph }}</p>
            {% endfor %}
        </div>
        <picture class="cs-picture">
            <source media="(min-width: 1024px)" srcset="{{ about.story.imageDesktop }}">
            <source media="(min-width: 601px)" srcset="{{ about.story.imageTablet }}">
            <source media="(max-width: 600px)" srcset="{{ about.story.imageMobile }}">
            <img loading="lazy" decoding="async" src="{{ about.story.imageDesktop }}" alt="{{ about.story.imageAlt }}" width="650" height="890">
        </picture>
    </div>
</section>

<!-- ============================================ -->
<!--                Our Values                    -->
<!-- ============================================ -->

<section id="about-values">
    <div class="cs-container">
        <div class="cs-content">
            <span class="cs-topper">{{ about.values.eyebrow }}</span>
            <h2 class="cs-title">{{ about.values.title }}</h2>
        </div>
        <ul class="cs-value-list">
            {% for value in about.values.items %}
            <li class="cs-value">
                <div class="cs-value-icon">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z"/></svg>
                </div>
                <h3 class="cs-value-title">{{ value.title }}</h3>
                <p class="cs-value-text">{{ value.body }}</p>
            </li>
            {% endfor %}
        </ul>
    </div>
</section>

<!-- ============================================ -->
<!--                About CTA                     -->
<!-- ============================================ -->

<section id="about-cta">
    <div class="cs-container">
        <div class="cs-content">
            <h2 class="cs-title">{{ about.cta.title }}</h2>
            <p class="cs-text">{{ about.cta.body }}</p>
            <a href="{{ about.cta.buttonUrl }}" class="cs-button-solid" target="_blank" rel="noopener">{{ about.cta.buttonText }}</a>
        </div>
    </div>
</section>
