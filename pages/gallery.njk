---
layout: layouts/base.njk
title: Website Design Portfolio
description: See recent website projects from Blue Canary Web Design, including small business, therapy practice, and nonprofit organization sites.
permalink: gallery/index.html
---

<section id="gallery-hero">
    <div class="cs-container">
        <div class="cs-content">
            <span class="cs-topper">{{ gallery.hero.eyebrow }}</span>
            <h1 class="cs-title">{{ gallery.hero.title }}</h1>
            <p class="cs-text">{{ gallery.hero.body }}</p>
        </div>
    </div>
</section>

<section id="gallery-grid">
    <div class="cs-container">
        <ul class="cs-gallery-list">
            {% for project in gallery.projects %}
            <li class="cs-gallery-item">
                <a class="cs-gallery-link" href="{{ project.url }}" target="_blank" rel="noopener">
                    <picture class="cs-gallery-picture">
                        <img class="cs-gallery-img" src="{{ project.image }}" alt="{{ project.alt }}" width="600" height="400" loading="lazy" decoding="async">
                    </picture>
                    <div class="cs-gallery-info">
                        <h2 class="cs-gallery-title">{{ project.title }}</h2>
                        <p class="cs-gallery-desc">{{ project.body }}</p>
                    </div>
                </a>
            </li>
            {% endfor %}
        </ul>
    </div>
</section>

<section id="gallery-cta">
    <div class="cs-container">
        <div class="cs-content">
            <h2 class="cs-title">{{ gallery.cta.title }}</h2>
            <p class="cs-text">{{ gallery.cta.body }}</p>
            <a href="{{ gallery.cta.buttonUrl }}" class="cs-button-solid" target="_blank" rel="noopener">{{ gallery.cta.buttonText }}</a>
        </div>
    </div>
</section>
