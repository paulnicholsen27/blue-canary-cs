---
layout: layouts/base.njk
title: Web Design Services for Small Business
description: "Explore our website design services: custom design, SEO-focused copywriting, and fast, accessible builds for small businesses."
permalink: services/index.html
---

<!-- ============================================ -->
<!--              Services Hero                   -->
<!-- ============================================ -->

<section id="services-hero">
    <div class="cs-container">
        <div class="cs-content">
            <span class="cs-topper">{{ services.hero.eyebrow }}</span>
            <h1 class="cs-title">{{ services.hero.title }}</h1>
            <p class="cs-text">
                {{ services.hero.body }}
            </p>
        </div>
    </div>
</section>

<!-- ============================================ -->
<!--              Core Services                   -->
<!-- ============================================ -->

<section id="services-core">
    <div class="cs-container">
        <ul class="cs-card-group">
            {% for item in services.items %}
            <li class="cs-item">
                <div class="cs-icon-wrapper">
                    {% if loop.index0 == 0 %}
                    <svg class="cs-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 5a1 1 0 0 1 1-1h14a1 1 0 0 1 1 1v11a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V5zm6 13h4v2H8l-1 2h10l-1-2h-2v-2h5a3 3 0 0 0 3-3V5a3 3 0 0 0-3-3H5a3 3 0 0 0-3 3v11a3 3 0 0 0 3 3h5v2z"/></svg>
                    {% elif loop.index0 == 1 %}
                    <svg class="cs-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" aria-hidden="true"><path d="M15.5 14h-.79l-.28-.27A6.471 6.471 0 0 0 16 9.5 6.5 6.5 0 1 0 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z"/></svg>
                    {% else %}
                    <svg class="cs-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" aria-hidden="true"><path d="M13 2.05v2.02c3.95.49 7 3.85 7 7.93 0 1.45-.39 2.81-1.06 3.98l1.73 1c.83-1.47 1.33-3.15 1.33-4.98 0-5.18-3.95-9.45-9-9.95zM12 19c-3.87 0-7-3.13-7-7 0-3.53 2.61-6.43 6-6.92V2.05c-5.06.5-9 4.76-9 9.95 0 5.52 4.47 10 9.99 10 3.31 0 6.24-1.61 8.06-4.09l-1.73-1A7.954 7.954 0 0 1 12 19z"/></svg>
                    {% endif %}
                </div>
                <h2 class="cs-h3">{{ item.title }}</h2>
                <p class="cs-item-text">
                    {{ item.body }}
                </p>
            </li>
            {% endfor %}
        </ul>
    </div>
</section>

<!-- ============================================ -->
<!--              Why Choose Us                   -->
<!-- ============================================ -->

<section id="services-why">
    <div class="cs-container">
        <div class="cs-content">
            <span class="cs-topper">{{ services.benefits.eyebrow }}</span>
            <h2 class="cs-title">{{ services.benefits.title }}</h2>
        </div>
        <ul class="cs-benefit-list">
            {% for item in services.benefits.items %}
            <li class="cs-benefit">
                <div class="cs-benefit-icon">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" aria-hidden="true"><path d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z"/></svg>
                </div>
                <div class="cs-benefit-content">
                    <h3 class="cs-benefit-title">{{ item.title }}</h3>
                    <p class="cs-benefit-text">{{ item.body }}</p>
                </div>
            </li>
            {% endfor %}
        </ul>
    </div>
</section>

<!-- ============================================ -->
<!--              How We Work                     -->
<!-- ============================================ -->

<section id="services-process">
    <div class="cs-container">
        <div class="cs-content">
            <span class="cs-topper">{{ services.process.eyebrow }}</span>
            <h2 class="cs-title">{{ services.process.title }}</h2>
            <p class="cs-text">{{ services.process.body }}</p>
        </div>
        <ul class="cs-process-list">
            {% for step in services.process.steps %}
            <li class="cs-step">
                <span class="cs-step-number">{{ loop.index }}</span>
                <h3 class="cs-step-title">{{ step.title }}</h3>
                <p class="cs-step-text">{{ step.body }}</p>
            </li>
            {% endfor %}
        </ul>
    </div>
</section>

<!-- ============================================ -->
<!--              Services CTA                    -->
<!-- ============================================ -->

<section id="services-cta">
    <div class="cs-container">
        <div class="cs-content">
            <h2 class="cs-title">{{ services.cta.title }}</h2>
            <p class="cs-text">{{ services.cta.body }}</p>
            <a href="{{ services.cta.buttonUrl }}" class="cs-button-solid" target="_blank" rel="noopener">{{ services.cta.buttonText }}</a>
        </div>
    </div>
</section>

