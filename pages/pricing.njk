---
layout: layouts/base.njk
title: Website Design Pricing & Plans
description: "Transparent, affordable website pricing with no hidden fees. Lump-sum, monthly, and ecommerce plans available, plus nonprofit discounts."
permalink: pricing/index.html
---

<!-- ============================================ -->
<!--                Pricing Hero                  -->
<!-- ============================================ -->

<section id="pricing-hero">
    <div class="cs-container">
        <div class="cs-content">
            <span class="cs-topper">{{ pricing.hero.eyebrow }}</span>
            <h1 class="cs-title">{{ pricing.hero.title }}</h1>
            <p class="cs-text">
                {{ pricing.hero.body }}
            </p>
        </div>
    </div>
            {% for plan in pricing.plans %}
            <li class="cs-card{% if plan.featured %} cs-featured{% endif %}">
                {% if plan.badge %}<span class="cs-badge">{{ plan.badge }}</span>{% endif %}
<!-- ============================================ -->
                    <span class="cs-card-label">{{ plan.label }}</span>
                    <h2 class="cs-card-title">{{ plan.title }}</h2>

                        <span class="cs-price">{{ plan.price }}</span>
                        <span class="cs-price-note">{{ plan.note }}</span>
        <ul class="cs-card-list">
            <!-- Lump Sum -->
            <li class="cs-card">
                    {% for feature in plan.features %}
                    <li class="cs-feature">
                    <span class="cs-card-label">One-Time Payment</span>
                        {{ feature }}
                        $150 per additional page
                    {% endfor %}
                    </li>
                <a href="{{ plan.buttonUrl }}" class="cs-card-button" target="_blank" rel="noopener">{{ plan.buttonText }}</a>
                        <svg class="cs-check" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" aria-hidden="true"><path d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z"/></svg>
            {% endfor %}
                        Shopify walkthrough
                    </li>
                    <li class="cs-feature">
                        <svg class="cs-check" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" aria-hidden="true"><path d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z"/></svg>
                        +$50/mo unlimited edits
                    </li>
                </ul>
                <a href="https://calendly.com/bluecanarywebdesign/initialconsult" class="cs-card-button" target="_blank" rel="noopener">Get Started</a>
            </li>
        </ul>
    </div>
</section>

<!-- ============================================ -->
<!--              Nonprofit Note                  -->
<!-- ============================================ -->

<section id="pricing-nonprofit">
    <div class="cs-container">
        <div class="cs-content">
            <span class="cs-topper">{{ pricing.nonprofit.eyebrow }}</span>
            <h2 class="cs-title">{{ pricing.nonprofit.title }}</h2>
            <p class="cs-text">
                {{ pricing.nonprofit.body }}
            </p>
        </div>
    </div>
</section>

<!-- ============================================ -->
<!--              Pricing CTA                     -->
<!-- ============================================ -->

<section id="pricing-cta">
    <div class="cs-container">
        <div class="cs-content">
            <h2 class="cs-title">{{ pricing.cta.title }}</h2>
            <p class="cs-text">{{ pricing.cta.body }}</p>
            <a href="{{ pricing.cta.buttonUrl }}" class="cs-button-solid" target="_blank" rel="noopener">{{ pricing.cta.buttonText }}</a>
        </div>
    </div>
</section>

<!-- FAQ Schema for SEO -->
<script type="application/ld+json">
{
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
        {
            "@type": "Question",
            "name": "How much does a custom website cost?",
            "acceptedAnswer": {
                "@type": "Answer",
                "text": "Our lump sum pricing starts at $2,900 for a 5-page website, plus $35/month for hosting. We also offer a monthly plan starting at $170/month with a $1,800 upfront fee, which includes hosting and unlimited edits."
            }
        },
        {
            "@type": "Question",
            "name": "Do you offer payment plans?",
            "acceptedAnswer": {
                "@type": "Answer",
                "text": "Yes! Our monthly plan lets you pay $170/month with a lower upfront cost of $1,800 instead of the full lump sum. This includes hosting and unlimited edits for the life of your subscription."
            }
        },
        {
            "@type": "Question",
            "name": "What's included in the website design?",
            "acceptedAnswer": {
                "@type": "Answer",
                "text": "All plans include custom design and development, mobile-responsive layouts, SEO optimization, and fast loading speeds. The lump sum plan includes up to 5 pages, while monthly plans include hosting and unlimited edits."
            }
        },
        {
            "@type": "Question",
            "name": "Do you offer discounts for nonprofits?",
            "acceptedAnswer": {
                "@type": "Answer",
                "text": "Yes, we offer discounted pricing for nonprofits and organizations focused on democracy, equality, and human kindness. Contact us to learn more about nonprofit rates."
            }
        },
        {
            "@type": "Question",
            "name": "How long does it take to build a website?",
            "acceptedAnswer": {
                "@type": "Answer",
                "text": "Most websites take 2-4 weeks from kickoff to launch, depending on the project scope and how quickly we receive content and feedback. We'll give you a timeline estimate during your free consultation."
            }
        }
    ]
}
</script>
